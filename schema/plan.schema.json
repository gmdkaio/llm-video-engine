          },
          "tone": {
           "$ref": "#/$defs/tone"
          }
         }
        }
       },
       "actual_until": {
        "type": "integer"
       },
       "actual_label": {
        "type": "string"
       },
       "split": {
        "$ref": "#/$defs/split"
       },
       "zero": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "label": {
          "type": "string"
         },
         "at": {
          "$ref": "#/$defs/at"
         }
        }
       },
       "at_series": {
        "$ref": "#/$defs/at"
       },
       "y": {
        "$ref": "#/$defs/y"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "stackbar"
       }
      }
     },
     "then": {
      "required": [
       "items"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "items": {
        "type": "array",
        "items": {
         "type": "array"
        }
       },
       "max": {
        "type": "number"
       },
       "target": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "value": {
          "type": "number"
         },
         "label": {
          "type": "string"
         }
        }
       },
       "end_label": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "label_divide": {
        "type": "number"
       },
       "label_decimals": {
        "type": "integer"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "ruler"
       }
      }
     },
     "then": {
      "required": [
