          },
          "value": {
           "type": "number"
          },
          "target": {
           "type": "number"
          },
          "format": {
           "$ref": "#/$defs/format"
          },
          "decimals": {
           "type": "integer"
          },
          "target_label": {
           "type": "string"
          },
          "tag": {
           "type": "string"
          },
          "at": {
           "$ref": "#/$defs/at"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
