    },
    "at": {
     "$ref": "#/$defs/at"
    },
    "items": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/node"
     }
    }
   }
  },
  "component": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "number",
      "text",
      "chips",
      "kv",
      "list",
      "bars",
      "lines",
      "stackbar",
      "ruler",
      "meter",
      "rings",
      "gauge",
      "flow",
      "calendar",
      "threshold",
      "callout",
      "bracket",
      "note"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "number"
       }
      }
     },
     "then": {
      "required": [
       "value"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "value": {
        "type": "number"
       },
       "format": {
        "$ref": "#/$defs/format"
       },
       "decimals": {
        "type": "integer"
       },
       "prefix": {
        "type": "string"
       },
       "suffix": {
        "type": "string"
       },
       "font": {
        "type": "number"
       },
       "tone": {
        "$ref": "#/$defs/tone"
       },
       "dur": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "text"
       }
      }
     },
     "then": {
      "required": [
       "text"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "text": {
        "type": "string"
       },
       "font": {
        "type": "number"
       },
       "tone": {
        "enum": [
         "text",
         "text2",
         "text3",
         "accent"
        ]
       },
       "width": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "chips"
       }
      }
     },
     "then": {
      "required": [
       "items"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "items": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/chip"
        }
       },
       "dir": {
        "enum": [
         "row",
         "column"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "kv"
       }
      }
     },
     "then": {
      "required": [
       "rows"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "title": {
        "type": "string"
       },
       "rows": {
        "type": "array",
        "items": {
         "$ref": "#/$defs/strings"
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "list"
       }
      }
     },
     "then": {
      "required": [
       "items"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "numbered": {
        "type": "boolean"
       },
       "items": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "title"
         ],
         "properties": {
