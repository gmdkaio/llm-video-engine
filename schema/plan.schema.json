           "type": "string"
          },
          "at": {
           "$ref": "#/$defs/at"
          }
         }
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "bars"
       }
      }
     },
     "then": {
      "required": [
       "cats",
       "values"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "cats": {
        "$ref": "#/$defs/strings"
       },
       "values": {
        "$ref": "#/$defs/numbers"
       },
       "highlight": {
        "oneOf": [
         {
          "$ref": "#/$defs/indices"
         },
         {
          "const": "last"
         },
         {
          "type": "null"
         }
        ]
       },
       "projection": {
        "$ref": "#/$defs/indices"
       },
       "ref": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "values"
        ],
        "properties": {
         "values": {
          "$ref": "#/$defs/numbers"
         },
         "at": {
          "$ref": "#/$defs/at"
         }
        }
       },
       "labels": {
        "type": "boolean"
       },
       "label_divide": {
        "type": "number"
       },
       "label_decimals": {
        "type": "integer"
       },
       "stack": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "values"
        ],
        "properties": {
         "values": {
          "$ref": "#/$defs/numbers"
         },
         "tone": {
          "$ref": "#/$defs/tone"
         },
         "label": {
          "type": "string"
         },
         "at": {
          "$ref": "#/$defs/at"
         }
        }
       },
       "focus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "idx"
        ],
        "properties": {
