{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "llm-video-engine/plan@1",
 "title": "llm-video-engine render plan",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "theme",
  "scenes"
 ],
 "properties": {
  "schema": {
   "const": "llm-video-engine/plan@1"
  },
  "output": {
   "type": "string"
  },
  "config": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "locale": {
     "type": "string"
    },
    "formats": {
     "type": "array",
     "items": {
      "enum": [
       "1080",
       "720"
      ]
     },
     "minItems": 1
    },
    "target_duration": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "theme": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bg",
    "text",
    "accent",
    "good",
    "bad",
    "warn"
   ],
   "properties": {
    "bg": {
     "$ref": "#/$defs/color"
    },
    "text": {
     "$ref": "#/$defs/color"
    },
    "accent": {
     "$ref": "#/$defs/color"
    },
    "good": {
     "$ref": "#/$defs/color"
    },
    "bad": {
     "$ref": "#/$defs/color"
    },
    "warn": {
     "$ref": "#/$defs/color"
    },
    "panel": {
     "$ref": "#/$defs/color"
    },
    "blue": {
     "$ref": "#/$defs/color"
    }
   }
  },
  "logos": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "brand": {
     "type": "string"
    },
    "brand_mark": {
     "type": "string"
    },
    "client": {
     "type": "string"
    },
    "client_color": {
     "$ref": "#/$defs/color"
    },
    "client_scale": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "brand_reveal": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "header": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "period": {
     "type": "string"
    }
   }
  },
  "scenes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/scene"
   }
  }
 },
 "$defs": {
  "color": {
   "type": "string",
   "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
  },
  "tone": {
   "enum": [
    "accent",
    "good",
    "bad",
    "warn",
    "neutral",
    "blue",
    "text"
   ]
  },
  "format": {
   "enum": [
    "k",
    "mil",
    "mi",
    "pct",
    "x",
    "days",
    "num"
   ]
  },
  "at": {
   "oneOf": [
    {
     "type": "number"
    },
    {
     "type": "string",
     "minLength": 1
    },
    {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "word"
     ],
     "properties": {
      "word": {
       "type": "string"
      },
      "n": {
       "type": "integer",
       "minimum": 1
      },
      "offset": {
       "type": "number"
      },
      "default": {
       "type": "number"
      }
     }
    }
   ]
  },
  "strings": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "numbers": {
   "type": "array",
   "items": {
    "type": "number"
   }
  },
  "indices": {
   "type": "array",
   "items": {
    "type": "integer",
    "minimum": 0
   }
  },
  "y": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    },
    "step": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "divide": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "decimals": {
     "type": "integer"
    },
    "suffix": {
     "type": "string"
    }
   }
  },
  "split": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "after"
   ],
   "properties": {
    "after": {
     "type": "integer",
     "minimum": 0
    },
    "labels": {
     "$ref": "#/$defs/strings"
    }
   }
  },
  "chip": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "text"
   ],
   "properties": {
    "text": {
     "type": "string"
    },
    "tone": {
     "$ref": "#/$defs/tone"
    },
    "at": {
     "$ref": "#/$defs/at"
    }
   }
  },
  "float": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "anchor": {
     "enum": [
      "top-left",
      "top-right",
      "bottom-left",
      "bottom-right"
     ]
    },
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    },
    "w": {
     "type": "number"
    }
   }
  },
  "scene": {
   "type": "object",
   "required": [
    "type"
   ],
   "properties": {
    "type": {
     "enum": [
      "intro",
      "outro",
      "slide",
      "content"
     ]
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "type": {
        "const": "intro"
       }
      }
     },
     "then": {
      "properties": {
       "type": {
        "const": "intro"
       },
       "speech": {
        "type": "string"
       },
       "sub": {
        "type": "string"
       },
       "duration": {
        "type": "number"
       }
      },
      "additionalProperties": false
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "outro"
       }
      }
     },
     "then": {
      "properties": {
       "type": {
        "const": "outro"
       },
       "text": {
        "type": "string"
       },
       "speech": {
        "type": "string"
       },
       "duration": {
        "type": "number"
       }
      },
      "additionalProperties": false
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "slide"
       }
      }
     },
     "then": {
      "properties": {
       "type": {
        "const": "slide"
       },
       "tab": {
        "type": "string"
       },
       "speech": {
        "type": "string"
       },
       "image": {
        "type": "string"
       },
       "focus": {
        "type": "array",
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "bbox"
         ],
         "properties": {
          "bbox": {
           "$ref": "#/$defs/numbers"
          },
          "callout": {
           "type": "string"
          },
          "at": {
           "$ref": "#/$defs/at"
          }
         }
        }
       }
      },
      "required": [
       "image"
      ],
      "additionalProperties": false
     }
    },
    {
     "if": {
      "properties": {
       "type": {
        "const": "content"
       }
      }
     },
     "then": {
      "properties": {
       "type": {
        "const": "content"
       },
       "tab": {
        "type": "string"
       },
       "speech": {
        "type": "string"
       },
       "kicker": {
        "$ref": "#/$defs/strings"
       },
       "title": {
        "type": "string"
       },
       "highlight": {
        "type": "string"
       },
       "chip": {
        "$ref": "#/$defs/chip"
       },
       "body": {
        "$ref": "#/$defs/node"
       }
      },
      "required": [
       "speech",
       "body"
      ],
      "additionalProperties": false
     }
    }
   ]
  },
  "node": {
   "if": {
    "required": [
     "type"
    ]
   },
   "then": {
    "$ref": "#/$defs/component"
   },
   "else": {
    "$ref": "#/$defs/box"
   }
  },
  "box": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "items"
   ],
   "properties": {
    "dir": {
     "enum": [
      "row",
      "column"
     ]
    },
    "gap": {
     "type": "number"
    },
    "size": {
     "type": "number"
    },
    "grow": {
     "type": "number"
    },
    "panel": {
     "oneOf": [
      {
       "type": "boolean"
      },
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "title": {
         "type": "string"
        },
        "sub": {
         "type": "string"
        }
       }
      }
