     "then": {
      "required": [
       "value",
       "max"
      ],
      "additionalProperties": false,
      "properties": {
       "type": true,
       "id": true,
       "at": true,
       "size": true,
       "grow": true,
       "float": true,
       "label": {
        "type": "string"
       },
       "value": {
        "type": "number"
       },
       "max": {
        "type": "number"
       },
       "marker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
